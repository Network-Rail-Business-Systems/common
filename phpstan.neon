includes:
    - ./vendor/larastan/larastan/extension.neon

parameters:
    level: 5
    paths:
        - src
    ignoreErrors:
        - identifier: trait.unused
        - '#Parameter \#1 \$view of function view expects view-string\|null, string given#'
        - '#Parameter \$markdown of class Illuminate\\Mail\\Mailables\\Content constructor expects view-string\|null, string given#'
